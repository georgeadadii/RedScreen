// Copy to Config/Local.xcconfig (git-ignored) and replace the team ID with yours.
//
// Add your Apple ID in Xcode › Settings › Accounts (a free Personal Team works), then read your
// team ID from your certificate's "OU" field. Note: the code in parentheses in the
// certificate's name ("Apple Development: you@example.com (ABCDE12345)") is NOT the team ID.
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// If `security find-identity -v -p codesigning` reports 0 valid identities, install Apple's
// "Worldwide Developer Relations - G3" intermediate certificate (see docs/CAPTURE_SHORTCUT.md).

DEVELOPMENT_TEAM = ABCDE12345
